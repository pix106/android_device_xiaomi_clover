#
system                                          /system        	erofs   	ro                                                           		wait,logical,avb=vbmeta,first_stage_mount
system                                          /system        	ext4    	ro,barrier=1                                                 		wait,logical,avb=vbmeta,first_stage_mount

system_ext                                      /system_ext    	erofs   	ro                                                           		wait,logical,avb,first_stage_mount
system_ext                                      /system_ext    	ext4    	ro,barrier=1                                                 		wait,logical,avb,first_stage_mount

product                                         /product       	erofs   	ro                                                           		wait,logical,avb,first_stage_mount
product                                         /product       	ext4    	ro,barrier=1                                                 		wait,logical,avb,first_stage_mount

vendor                                          /vendor        	erofs   	ro                                                           		wait,logical,avb,first_stage_mount
vendor                                          /vendor        	ext4    	ro,barrier=1                                                 		wait,logical,avb,first_stage_mount

odm                                             /odm           	erofs   	ro                                                           		wait,logical,avb,first_stage_mount
odm                                             /odm           	ext4    	ro,barrier=1                                                 		wait,logical,avb,first_stage_mount

#/dev/block/bootdevice/by-name/userdata   	/data          	f2fs   		nosuid,nodev,barrier=1,noauto_da_alloc,noatime,lazytime,inlinecrypt   	wait,check,fileencryption=ice,quota,reservedsize=128M

/dev/block/by-name/logdump                      /metadata      	ext4    	noatime,nosuid,nodev,data=journal,commit=1                   		wait,check,formattable,first_stage_mount
#
